# ─────────────────────────────────────────────
#  Burndown Stack  –  Environment Variables
#  Save as .env (next to docker-compose.yml)
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=burndown
POSTGRES_USER=burndown
POSTGRES_PASSWORD=SECURE_PASSWORD_HERE

# InvoiceNinja
INVOICENINJA_URL=https://your-invoiceninja-instance.example.com
INVOICENINJA_API_KEY=YOUR_API_KEY_HERE

# Sync Worker
SYNC_INTERVAL_MINUTES=10

# API (optional)
# CORS_ORIGIN=http://localhost:8088   # Allowed CORS origin; leave unset to deny all cross-origin requests

# AI Dashboard — uses the Ollama running on the Docker host (not bundled with this stack).
# Prerequisite on the host: ollama pull qwen2.5:7b
# OLLAMA_URL=http://host.docker.internal:11434   # default; example override: http://macmini.local:11434
#   (*.local names often don't resolve inside containers — use the host IP if status stays 'unavailable')
# OLLAMA_MODEL=qwen2.5:7b                         # must be installed on the host; the stack never pulls models
